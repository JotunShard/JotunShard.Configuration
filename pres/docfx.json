{
	"metadata": [
		{
			"src": [
				{
					"src": "../",
					"files": [
						"src/**.csproj"
					]
				}
			],
			"dest": "../pres/api/netstandard1.3",
			"properties": {
				"TargetFramework": "netstandard1.3"
			}
		},
		{
			"src": [
				{
					"src": "../",
					"files": [
						"src/**.csproj"
					]
				}
			],
			"dest": "../pres/api/netstandard2.0",
			"properties": {
				"TargetFramework": "netstandard2.0"
			}
		}
	],
	"build": {
		"content": [
			{
				"files": [
					"api/**.yml",
					"api/index.md"
				]
			},
			{
				"files": [
					"articles/**.md",
					"articles/**/toc.yml",
					"toc.yml",
					"*.md"
				],
				"exclude": [
					"obj/**"
				]
			}
		],
		"resource": [
			{
				"files": [
					"images/**"
				],
				"exclude": [
					"obj/**"
				]
			}
		],
		"overwrite": [
			{
				"files": [
					"apidoc/**.md"
				],
				"exclude": [
					"obj/**"
				]
			}
		],
		"dest": "../docs",
		"globalMetadataFiles": [],
		"fileMetadataFiles": [],
		"template": [
			"default"
		],
		"postProcessors": [],
		"noLangKeyword": false,
		"keepFileLink": false,
		"cleanupCacheHistory": false
	}
}